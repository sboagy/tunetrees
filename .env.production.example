# TuneTrees PWA - Production Environment Variables
# Copy this file to .env.production and fill in your actual values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Sync Worker URL (REQUIRED for production)
# This should point to your deployed Cloudflare Worker
# The worker handles sync operations between local SQLite and Supabase
VITE_WORKER_URL=https://tunetrees-sync-worker.your-subdomain.workers.dev

# Dropbox BYOS: production app's public App key (not App secret).
# Leave empty to disable Dropbox; otherwise paste the actual App key here.
# Preferred: .env.prod.template resolves op://rhizome/shared-production/Dropbox/DROPBOX_CLIENT_ID
# through 1Password. Plain .env.production does not resolve op:// references.
# Register https://<production-app-host>/byos/callback?provider=dropbox in Dropbox.
VITE_DROPBOX_CLIENT_ID=

# Optional: Development overrides
# VITE_WORKBOX_DEBUG=false
